# 系统配置文件
# 请根据实际情况修改以下配置

# SMTP配置（用于发送邮件）
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your_email@qq.com
SMTP_PASSWORD=your_authorization_code

# 支付宝配置
ALIPAY_ACCOUNT=your_alipay_account

# 微信支付配置
WECHAT_ACCOUNT=your_wechat_account

# 系统配置
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
DATABASE_PATH=bank_card_system.db
HOST=0.0.0.0
PORT=5000

# 配置说明：
# 1. SMTP_USERNAME: 发件人邮箱地址（例如：your_email@qq.com）
# 2. SMTP_PASSWORD: 邮箱授权码，不是登录密码
#    - QQ邮箱：登录QQ邮箱 -> 设置 -> 账户 -> POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 -> 开启服务 -> 生成授权码
#    - 其他邮箱：请参考相应邮箱的帮助文档
# 3. ALIPAY_ACCOUNT: 支付宝账号或收款码
# 4. WECHAT_ACCOUNT: 微信支付账号或收款码
# 5. SECRET_KEY: Flask应用的密钥，用于加密session，请使用随机字符串
